                </td>
                <td class="unavailable">
                    <img src="icons/unavailable.svg" alt="Unavailable" height="32px">
                </td>
            </tr>
            <tr>
                <th>Afternoon</th>
                <td class="available">
                    <img src="icons/available_bold.svg" alt="Available" height="32px">
                </td>
                <td class="available">
                    <img src="icons/available_bold.svg" alt="Available" height="32px">
                </td>
                <td class="available">
                    <img src="icons/available_bold.svg" alt="Available" height="32px">
                </td>
                <td class="available">
                    <img src="icons/available_bold.svg" alt="Available" height="32px">
